<UserControl x:Class="LISSTech.Billboard.Controls.NotificationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border x:Name="CardBorder"
          CornerRadius="14"
          BorderThickness="2"
          Background="Transparent"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Header (spans full width) -->
      <Border x:Name="HeaderBorder" Grid.Row="0" Grid.ColumnSpan="2" Padding="14,14,24,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border x:Name="Badge"
                  Grid.Column="0"
                  Width="32" Height="32"
                  CornerRadius="8">
            <Path x:Name="BadgeIcon"
                  Width="18" Height="18"
                  Stretch="Uniform"
                  StrokeThickness="2"
                  Fill="Transparent" />
          </Border>

          <TextBlock x:Name="TypeLabel"
                     Grid.Column="1"
                     Style="{StaticResource TypeLabel}"
                     VerticalAlignment="Center"
                     Margin="14,0,0,0" />

          <Image x:Name="MspLogoImage"
                 Grid.Column="3"
                 Width="28" Height="28"
                 VerticalAlignment="Center"
                 Margin="0,0,14,0"
                 Opacity="0.5"
                 Stretch="Uniform"
                 IsHitTestVisible="False" />

          <Button x:Name="CloseButton"
                  Grid.Column="4"
                  Width="28" Height="28"
                  Click="OnCloseClick">
            <Path Data="{StaticResource Icon.X}"
                  Width="16" Height="16"
                  Stretch="Uniform"
                  StrokeThickness="2" />
          </Button>
        </Grid>
      </Border>

      <!-- Illustration side panel (modal only) -->
      <Border x:Name="IllustrationPanel"
              Grid.Row="1" Grid.Column="0"
              Width="360"
              MinHeight="400"
              Visibility="Collapsed"
              CornerRadius="0,0,0,14"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="IllustrationPanelImage"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="10"
                 IsHitTestVisible="False" />

          <!-- Brand name (over illustration, bottom) -->
          <TextBlock x:Name="PanelBrandText"
                     Text="LISS TECHNOLOGIES"
                     Style="{StaticResource BrandText}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,20" />
        </Grid>
      </Border>

      <!-- Card content -->
      <Grid Grid.Row="1" Grid.Column="1">

        <!-- Toast illustration overlay (behind content) -->
        <Image x:Name="IllustrationImage"
               Visibility="Collapsed"
               Stretch="Uniform"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Width="180"
               Margin="0,0,12,12"
               Opacity="0.12"
               IsHitTestVisible="False" />

        <!-- Card content (on top of illustration) -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Body -->
          <StackPanel x:Name="BodyPanel" Grid.Row="0" Margin="32,28,32,16"
                      VerticalAlignment="Top">
            <TextBlock x:Name="TitleBlock"
                       Style="{StaticResource ToastTitle}"
                       TextWrapping="Wrap" />

            <FlowDocumentScrollViewer x:Name="MessageViewer"
                                      Margin="0,16,0,0"
                                      MaxHeight="350"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      Padding="0" />
          </StackPanel>

          <!-- Context footer (own row, no overlap) -->
          <TextBlock x:Name="ContextFooter"
                     Grid.Row="1"
                     HorizontalAlignment="Left"
                     Margin="30,8,30,24"
                     FontFamily="Cascadia Code, Aptos, Consolas, Segoe UI"
                     FontSize="11.5"
                     LineHeight="19"
                     Opacity="0.28"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />

          <!-- Buttons (bottom-aligned) -->
          <StackPanel Grid.Row="2">
            <Grid x:Name="ButtonPanel" Margin="32,0,32,28" />

            <!-- Brand footer (non-illustration modals) -->
            <TextBlock x:Name="BrandFooter"
                       Text="LISS TECHNOLOGIES"
                       Style="{StaticResource BrandText}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"
                       Visibility="Collapsed" />
          </StackPanel>

        </Grid>
      </Grid>
    </Grid>
  </Border>

</UserControl>
