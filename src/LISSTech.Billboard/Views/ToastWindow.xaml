<Window x:Class="LISSTech.Billboard.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LISSTech.Billboard.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="420"
        MaxHeight="800"
        SizeToContent="Height">

  <Border x:Name="CardBorder" CornerRadius="14">
    <controls:NotificationCard x:Name="Card" IsModal="False" />
  </Border>

</Window>
