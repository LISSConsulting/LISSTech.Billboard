<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Lucide icons (https://lucide.dev) — 24x24 viewBox, stroke-based.
    SVG <circle> elements converted to arc paths (M cx,cy-r A r,r 0 1 0 0.001,0 Z).
    Multiple sub-paths combined with a space separator; WPF Geometry.Parse supports this.
    Icons: info, triangle-alert, bell-ring, octagon-x, circle-help, x
  -->

  <!-- info: circle with vertical bar and dot -->
  <!-- circle cx=12 cy=12 r=10 converted to arc path -->
  <Geometry x:Key="Icon.Info">M12 2 A10 10 0 1 0 12.001 2 Z M12 16 L12 12 M12 8 L12.01 8</Geometry>

  <!-- triangle-alert: triangle outline with ! -->
  <Geometry x:Key="Icon.TriangleAlert">M21.73 18 L13.73 4 A2 2 0 0 0 10.27 4 L2.27 18 A2 2 0 0 0 4 21 L20 21 A2 2 0 0 0 21.73 18 Z M12 9 L12 13 M12 17 L12.01 17</Geometry>

  <!-- bell-ring: bell body with clapper arc and two ring arcs -->
  <Geometry x:Key="Icon.BellRing">M10.268 21 A2 2 0 0 0 13.732 21 M22 8 A10 10 0 0 0 20 2 M4 2 A10 10 0 0 0 2 8 M3.262 15.326 A1 1 0 0 0 4 17 L20 17 A1 1 0 0 0 20.74 15.327 C19.41 13.956 18 12.499 18 8 A6 6 0 0 0 6 8 C6 12.499 4.589 13.956 3.262 15.326 Z</Geometry>

  <!-- octagon-x: octagon outline with X inside -->
  <Geometry x:Key="Icon.OctagonX">M2.586 16.726 A2 2 0 0 1 2 15.312 L2 8.688 A2 2 0 0 1 2.586 7.274 L7.274 2.586 A2 2 0 0 1 8.688 2 L15.312 2 A2 2 0 0 1 16.726 2.586 L21.414 7.274 A2 2 0 0 1 22 8.688 L22 15.312 A2 2 0 0 1 21.414 16.726 L16.726 21.414 A2 2 0 0 1 15.312 22 L8.688 22 A2 2 0 0 1 7.274 21.414 Z M15 9 L9 15 M9 9 L15 15</Geometry>

  <!-- circle-help: circle with ? and dot -->
  <Geometry x:Key="Icon.CircleHelp">M12 2 A10 10 0 1 0 12.001 2 Z M9.09 9 A3 3 0 0 1 14.92 10 C14.92 12 11.92 13 11.92 13 M12 17 L12.01 17</Geometry>

  <!-- x: two diagonal lines -->
  <Geometry x:Key="Icon.X">M18 6 L6 18 M6 6 L18 18</Geometry>

</ResourceDictionary>
