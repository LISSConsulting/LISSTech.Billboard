# Code signing certificate thumbprint (SHA-1 hash from Windows certificate store)
# Leave empty or remove to build without signing
CODE_SIGNING_CERTIFICATE_THUMBPRINT=

# PowerShell Gallery NuGet API key (for publishing the PS module)
# Get yours at https://www.powershellgallery.com/account/apikeys
PSGALLERY_API_KEY=

# macOS Developer ID identity names and local keychain-backed notarization profile
# These are public identifiers only; never put private keys or passwords in this file
MACOS_APP_IDENTITY=
MACOS_INSTALLER_IDENTITY=
MACOS_NOTARY_PROFILE=
MACOS_KEYCHAIN=
